<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/roiOverlay"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_roi_frame" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System: Ready for Baseline"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:background="@drawable/bg_screen_panel"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:letterSpacing="0.02"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartRecord"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_blue"
                android:text="RECORD"
                android:textColor="@color/text_dark_btn"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />

            <Space
                android:layout_width="24dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnBackBaseline"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_red"
                android:text="BACK"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
