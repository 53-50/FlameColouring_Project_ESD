<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_screen_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Logo"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:text="Select Recording Type:"
                    android:textColor="@color/text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRecordBaseline"
                            android:layout_width="170dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_orange"
                            android:text="Record Baseline"
                            android:textAllCaps="false"
                            android:textColor="@color/white" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnViewBaseline"
                            android:layout_width="72dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_green"
                            android:text="VIEW"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRecordReference"
                            android:layout_width="170dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_orange"
                            android:text="Record Reference"
                            android:textAllCaps="false"
                            android:textColor="@color/white" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnViewReference"
                            android:layout_width="72dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_green"
                            android:text="VIEW"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRecordSample"
                            android:layout_width="170dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_orange"
                            android:text="Record Sample"
                            android:textAllCaps="false"
                            android:textColor="@color/white" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnViewSample"
                            android:layout_width="72dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_gray"
                            android:enabled="true"
                            android:text="VIEW"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnCompare"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_button_yellow"
                        android:text="Comp."
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLoadDemo"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_button_orange"
                        android:text="Demo"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnExport"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_button_green"
                        android:text="Export"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnQuit"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_red"
                        android:text="Quit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>